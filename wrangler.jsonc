{
  "name": "movie",
  "main": "worker/source-sync-app.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SOURCE_SYNC",
        "class_name": "SourceSync"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SourceSync"
      ]
    }
  ],
  "vars": {
    "SOURCE_POLICIES": "[]"
  }
}
